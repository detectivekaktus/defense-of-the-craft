			"config": "defense-of-the-craft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"yet_another_config_lib_v3": ">=3.6.1+1.21-fabric",
		"modmenu": ">=11.0.4"
	},
	"suggests": {
		"damagenumbers": ">=1.4.1"
	}
